{
  "name": "jira-etl-dashboard",
  "version": "0.14.0",
  "description": "JIRA ETL Dashboard with Analytics and KPI Tracking",
  "author": "CJ-1981",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack -p 3000",
    "dev:turbo": "next dev --turbo -p 3000",
    "dev:low-memory": "cross-env NODE_OPTIONS=--max-old-space-size=2048 next dev -p 3000",
    "prisma:setup": "node scripts/prisma-setup.mjs",
    "predev": "node scripts/prisma-setup.mjs",
    "prebuild": "node scripts/prisma-setup.mjs",
    "build": "next build && npm run copy:files",
    "build:analyze": "cross-env ANALYZE=true next build",
    "build:static": "node scripts/build-static.mjs",
    "relay": "python scripts/jira_relay.py",
    "copy:files": "shx cp -r .next/static .next/standalone/.next/ && shx cp -r public .next/standalone/",
    "start": "cross-env NODE_ENV=production node .next/standalone/server.js",
    "start:log": "cross-env NODE_ENV=production node .next/standalone/server.js > server.log 2>&1",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "db:push": "prisma db push",
    "db:template": "node scripts/create-db-template.mjs",
    "db:push:pg": "prisma db push --schema=prisma/schema.postgresql.prisma",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "type-check": "tsc --noEmit",
    "hooks:install": "node scripts/hooks/install-hooks.mjs",
    "clean": "shx rm -rf .next node_modules/.cache",
    "clean:full": "shx rm -rf .next node_modules/.cache && shx rm -rf node_modules/.prisma",
    "dev:clean": "npm run clean && npm run dev",
    "db:deploy": "prisma migrate deploy",
    "postinstall": "node scripts/prisma-setup.mjs && node scripts/hooks/install-hooks.mjs",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/client": "^6.11.1",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-radio-group": "^1.3.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@swc/helpers": "^0.5.21",
    "@tanstack/react-query": "^5.82.0",
    "@tanstack/react-query-devtools": "^5.100.8",
    "@tanstack/react-table": "^8.21.3",
    "chokidar": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "framer-motion": "^12.23.2",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.525.0",
    "next": "^16.1.7",
    "next-themes": "^0.4.6",
    "pg": "^8.20.0",
    "prisma": "^6.11.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-virtuoso": "^4.18.6",
    "recharts": "^2.15.4",
    "sharp": "^0.35.3",
    "sonner": "^2.0.6",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^11.1.0",
    "zod": "^4.0.2",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.6",
    "@vitest/ui": "^4.1.6",
    "caxa": "^3.0.1",
    "cross-env": "^7.0.3",
    "eslint": "^9",
    "eslint-config-next": "^16.1.7",
    "jsdom": "^29.1.1",
    "shx": "^0.3.4",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5",
    "vitest": "^4.1.6"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  }
}
