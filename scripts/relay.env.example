# Jira ETL relay configuration (standalone exe / scripts/jira_relay.py)
#
# Copy this file to `relay.env` next to jira-relay.exe (or the repo root when
# running the script) and fill in your values. Real environment variables
# always take precedence over this file.
#
# NOTE: relay.env contains your Jira API token — it is gitignored; never commit it.

# Jira instance (required for /sync)
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@company.com
JIRA_API_TOKEN=your-api-token

# Where the master dataset is stored (default: data/relay.db next to the exe)
# JIRA_RELAY_DB=C:\jira-relay\data\relay.db

# Listen port (default 8765) — must match the Relay URL in the dashboard
# JIRA_RELAY_PORT=8765

# Pin CORS to your GitHub Pages origin — REQUIRED for the dashboard to load
# data. Unset (default), the relay sends no CORS headers and browser pages on
# other origins cannot read its responses. Never set to * on a machine whose
# dataset must not be readable by arbitrary websites.
ALLOWED_ORIGIN=https://user.github.io
#
# NOTE: code-signing variables (JIRA_RELAY_SIGN_PFX / JIRA_RELAY_SIGN_PASSWORD /
# JIRA_RELAY_SIGN_THUMBPRINT) are BUILD-time settings for build-relay-exe.bat —
# set them as environment variables when building, not in this runtime file.
