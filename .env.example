# =============================================================================
# JIRA ETL Dashboard — example environment configuration
# Copy this file to .env and adjust as needed. Never commit real secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (required in practice; the app falls back to the default below)
# -----------------------------------------------------------------------------
# SQLite connection string, relative paths resolve against the prisma/ folder.
# The default local-dev value is used automatically when this variable is
# absent. For PostgreSQL use: postgresql://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL="file:./db/custom.db"

# Optional client-side fallback read by the DB layer when DATABASE_URL is not
# visible on the server. Normally you do not need to set this.
# NEXT_PUBLIC_DATABASE_URL="file:./db/custom.db"

# -----------------------------------------------------------------------------
# Jira integration (optional)
# -----------------------------------------------------------------------------
# Shared secret for the inbound Jira webhook endpoint (/api/webhooks/jira).
# Optional but RECOMMENDED: when set, every webhook request must present it
# (via the x-jira-webhook-secret header or ?secret= query param). When unset,
# the endpoint only accepts requests that originate from loopback.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# JIRA_WEBHOOK_SECRET="change-me-to-a-long-random-string"

# Optional overrides for non-standard Jira custom field ids (read server-side
# by src/lib/jira/field-config.ts; field ids differ per Jira instance — see
# docs/JIRA_FIELD_CONFIGURATION.md). When unset the built-in defaults apply.
# JIRA_ISSUE_OWNER_TEAM_FIELD="customfield_10132"
# JIRA_STORY_POINTS_FIELD="customfield_10002"

# -----------------------------------------------------------------------------
# KPI plugins (optional)
# -----------------------------------------------------------------------------
# Directory scanned for custom KPI plugins.
# Defaults to <project>/data/custom-plugins when unset.
# CUSTOM_PLUGIN_DIR="./data/custom-plugins"

# -----------------------------------------------------------------------------
# Production launcher (launcher.cjs — all optional)
# -----------------------------------------------------------------------------
# Port for the packaged/production server. When unset the launcher scans for a
# free port starting at 3200. (During `npm run dev` the port is fixed to 3000.)
# PORT=3200

# Bind address for the production server. Defaults to 127.0.0.1 — the app has
# no authentication, so keep it loopback-only unless you know what you are doing.
# HOSTNAME=127.0.0.1

# Explicit override for the production data directory (where the SQLite
# database lives). When unset the launcher uses the platform app-data folder
# (packaged exe) or a ./data folder next to the app (portable layout).
# JIRA_ETL_DATA_DIR=""

# -----------------------------------------------------------------------------
# Auto-injected build variables — DO NOT SET THESE MANUALLY
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_APP_VERSION and NEXT_PUBLIC_BUILD_DATE are injected at build time
# by next.config.ts (from package.json and the current date). Setting them in
# .env has no effect on the shipped bundle.

# -----------------------------------------------------------------------------
# LEGACY / UNUSED — kept only for compatibility with existing .env files
# -----------------------------------------------------------------------------
# Authentication is not implemented in this app (next-auth has been removed).
# These variables are ignored by the current code and can be safely removed.
# ADMIN_USERNAME=""
# ADMIN_PASSWORD=""
# NEXTAUTH_SECRET=""
# NEXTAUTH_URL=""
