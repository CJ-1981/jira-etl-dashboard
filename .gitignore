# ============================================
# Jira ETL Dashboard .gitignore
# ============================================

# Dependencies
node_modules/

# Next.js
.next/
out/
next-env.d.ts
*.tsbuildinfo

# Build output & release artifacts
build/
dist/
release/app/
release/*.7z
release/*.zip
!release/README.md
release_prod/

# Prisma & local databases
prisma/generated/
prisma/db/
/db/
*.db
*.db-journal
*.sqlite
*.sqlite3

# Local ETL data (input files, exported configs)
data/*
kpi-plugin-config.json

# Tests & coverage
coverage/
coverage.json
test-results/
playwright-report/
e2e/.auth/
scripts/*.log
scripts/temp/

# Logs & temporary files
*.log
logs/
*.tmp
*.temp
*.bak
*.backup

# Environment & secrets
.env
.env.*
!.env.example
*.pem
*.p12
*.pfx
*.jks

# AI tools & agent workspaces
.claude/
.moai/
.moai-backups/
.antigravitycli/
.kilo/
.kilocode/
.zcode/
_workspace/
docu/
plan/
scratch/
.mcp.json

# IDE & editors
.vscode/
.idea/
.cursor/
*.swp
*.swo
*.sw?
*~

# OS files
.DS_Store
Thumbs.db
[Dd]esktop.ini

# Deployment platforms
.vercel/
.netlify/
.firebase/
